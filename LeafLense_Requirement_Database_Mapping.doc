}
tr:nth-child(even) {
    background-color: #f1f8e9;
}
.badge-yes {
    background-color: #2e7d32;
    color: #ffffff;
    font-weight: bold;
    padding: 2px 7px;
    border-radius: 3px;
    display: inline-block;
    font-size: 9pt;
}
