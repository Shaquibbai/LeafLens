    color: #222222;
    margin: 35px;
}
h1 {
    font-size: 20pt;
    color: #1b5e20;
    border-bottom: 2.5px solid #2e7d32;
    padding-bottom: 6px;
    margin-top: 0;
}
h2 {
    font-size: 14pt;
    color: #2e7d32;
    margin-top: 24px;
    border-bottom: 1px solid #a5d6a7;
    padding-bottom: 4px;
}
